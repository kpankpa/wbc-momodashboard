# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="White Beam Concepts MoMo Desk"
APP_URL=http://localhost:3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-long-random-secret
AUTH_TRUST_HOST=true

# Database
# Local (SQLite): works out of the box
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/momo_dashboard?sslmode=require"

# First admin (used by seed script only)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe-Strong-Password-123!

# MoMo API (Phase 3+) — never expose to the browser
MOMO_ENVIRONMENT=sandbox
# Production example:
# MOMO_ENVIRONMENT=production
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# MOMO_TARGET_ENVIRONMENT=mtnghana
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_HOST=
MOMO_TARGET_ENVIRONMENT=sandbox
# Shared secret to validate incoming callbacks (required in production)
# Send as header X-Webhook-Secret, Authorization: Bearer, or ?token=
MOMO_WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# Admin dashboard simulate button. Forced off when MOMO_ENVIRONMENT=production.
MOMO_ALLOW_SIMULATE=true
